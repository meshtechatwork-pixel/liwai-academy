# GEMINI_API_KEY: Required for server-side Gemini AI prompt generation.
# Configure this via Settings > Secrets in AI Studio or in your deployment environment.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where Learn It With AI is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000)
PORT="3000"
