rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'meshtechatwork@gmail.com';
    }

    // Student avatars: owner can read/write their own folder (max 5 MB image)
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Course thumbnails, lesson videos, and downloadable resources: public read, admin write
    match /course_thumbnails/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /lesson_videos/{courseId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isAdmin()
        && request.resource.size < 250 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }

    match /lesson_resources/{courseId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isAdmin()
        && request.resource.size < 25 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
