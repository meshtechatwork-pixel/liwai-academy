rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HELPERS ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidCompositeId(id) {
      return id is string && id.size() >= 1 && id.size() <= 260 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'meshtechatwork@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin()
        || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidCategory(cat) {
      return cat is string && cat in [
        'Web Design',
        'Web Development',
        'Social Media Management',
        'Video Editing',
        'AI Prompt Generator'
      ];
    }

    function isValidLevel(lvl) {
      return lvl is string && lvl in ['Beginner', 'Intermediate', 'Advanced'];
    }

    // --- ENTITY VALIDATORS ---
    function isValidCourse(data) {
      return data.keys().hasAll([
          'id', 'title', 'category', 'level', 'description',
          'instructor', 'duration', 'thumbnailUrl', 'lessonCount',
          'published', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'title', 'category', 'level', 'description',
          'instructor', 'duration', 'thumbnailUrl', 'lessonCount',
          'published', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 140
        && isValidCategory(data.category)
        && isValidLevel(data.level)
        && data.description is string && data.description.size() >= 10 && data.description.size() <= 2000
        && data.instructor is string && data.instructor.size() >= 2 && data.instructor.size() <= 100
        && data.duration is string && data.duration.size() >= 2 && data.duration.size() <= 40
        && data.thumbnailUrl is string && data.thumbnailUrl.size() <= 1000
        && data.lessonCount is int && data.lessonCount >= 0 && data.lessonCount <= 200
        && data.published is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLesson(data, courseId) {
      return data.keys().hasAll([
          'id', 'courseId', 'order', 'title', 'duration', 'summary',
          'videoUrl', 'resourceTitle', 'resourceContent', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'courseId', 'order', 'title', 'duration', 'summary',
          'videoUrl', 'resourceTitle', 'resourceUrl', 'resourceContent', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.courseId == courseId
        && data.order is int && data.order >= 1 && data.order <= 200
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 160
        && data.duration is string && data.duration.size() >= 2 && data.duration.size() <= 40
        && data.summary is string && data.summary.size() >= 5 && data.summary.size() <= 2000
        && data.videoUrl is string && data.videoUrl.size() <= 1000
        && data.resourceTitle is string && data.resourceTitle.size() <= 160
        && (!data.keys().hasAny(['resourceUrl']) || (data.resourceUrl is string && data.resourceUrl.size() <= 1000))
        && data.resourceContent is string && data.resourceContent.size() <= 10000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCourseLevel(data) {
      return data.keys().hasAll(['id', 'name', 'description', 'sortOrder', 'active', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'description', 'sortOrder', 'active', 'updatedAt'])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 40
        && data.description is string && data.description.size() <= 500
        && data.sortOrder is int && data.sortOrder >= 1 && data.sortOrder <= 50
        && data.active is bool
        && data.updatedAt is timestamp;
    }

    function isValidStudentProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'firstName', 'lastName', 'email', 'phone',
          'country', 'countyOrState', 'townOrCity', 'avatarUrl',
          'selectedCourseId', 'selectedLevel', 'role', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'firstName', 'lastName', 'email', 'phone',
          'country', 'countyOrState', 'townOrCity', 'avatarUrl',
          'selectedCourseId', 'selectedLevel', 'role', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == userId
        && data.firstName is string && data.firstName.size() >= 1 && data.firstName.size() <= 80
        && data.lastName is string && data.lastName.size() >= 1 && data.lastName.size() <= 80
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.phone is string && data.phone.size() <= 40
        && data.country is string && data.country.size() <= 80
        && data.countyOrState is string && data.countyOrState.size() <= 80
        && data.townOrCity is string && data.townOrCity.size() <= 80
        && data.avatarUrl is string && data.avatarUrl.size() <= 1000
        && data.selectedCourseId is string && data.selectedCourseId.size() <= 128
        && isValidLevel(data.selectedLevel)
        && data.role is string && data.role in ['student', 'admin']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidEnrollment(data) {
      return data.keys().hasAll([
          'id', 'userId', 'courseId', 'courseTitle', 'courseCategory',
          'level', 'completedLessonIds', 'progressPercent', 'status',
          'enrolledAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'courseId', 'courseTitle', 'courseCategory',
          'level', 'completedLessonIds', 'progressPercent', 'status',
          'enrolledAt', 'updatedAt', 'completedAt'
        ])
        && isValidCompositeId(data.id)
        && isValidId(data.userId)
        && isValidId(data.courseId)
        && data.courseTitle is string && data.courseTitle.size() >= 1 && data.courseTitle.size() <= 140
        && data.courseCategory is string && data.courseCategory.size() >= 1 && data.courseCategory.size() <= 60
        && isValidLevel(data.level)
        && data.completedLessonIds is list
        && data.completedLessonIds.size() <= 100
        && (data.completedLessonIds.size() == 0 || data.completedLessonIds[0] is string)
        && data.progressPercent is int && data.progressPercent >= 0 && data.progressPercent <= 100
        && data.status is string && data.status in ['in_progress', 'completed']
        && data.enrolledAt is timestamp
        && data.updatedAt is timestamp
        && (!data.keys().hasAny(['completedAt']) || data.completedAt is timestamp);
    }

    function isValidCertificate(data) {
      return data.keys().hasAll([
          'id', 'userId', 'studentName', 'courseId', 'courseTitle',
          'courseCategory', 'level', 'certificateCode', 'issuedBy', 'issuedAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'studentName', 'courseId', 'courseTitle',
          'courseCategory', 'level', 'certificateCode', 'issuedBy', 'issuedAt'
        ])
        && isValidCompositeId(data.id)
        && isValidId(data.userId)
        && data.studentName is string && data.studentName.size() >= 2 && data.studentName.size() <= 160
        && isValidId(data.courseId)
        && data.courseTitle is string && data.courseTitle.size() >= 2 && data.courseTitle.size() <= 140
        && data.courseCategory is string && data.courseCategory.size() >= 2 && data.courseCategory.size() <= 60
        && isValidLevel(data.level)
        && data.certificateCode is string && data.certificateCode.size() >= 4 && data.certificateCode.size() <= 64
        && data.issuedBy is string && data.issuedBy.size() >= 2 && data.issuedBy.size() <= 120
        && data.issuedAt is timestamp;
    }

    function isValidSavedPrompt(data) {
      return data.keys().hasAll([
          'id', 'userId', 'category', 'platform', 'purpose',
          'tone', 'outputFormat', 'topic', 'generatedPrompt', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'category', 'platform', 'purpose',
          'tone', 'outputFormat', 'topic', 'generatedPrompt', 'createdAt'
        ])
        && isValidId(data.id)
        && isValidId(data.userId)
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 80
        && data.platform is string && data.platform.size() >= 1 && data.platform.size() <= 80
        && data.purpose is string && data.purpose.size() >= 1 && data.purpose.size() <= 120
        && data.tone is string && data.tone.size() >= 1 && data.tone.size() <= 60
        && data.outputFormat is string && data.outputFormat.size() >= 1 && data.outputFormat.size() <= 60
        && data.topic is string && data.topic.size() <= 500
        && data.generatedPrompt is string && data.generatedPrompt.size() >= 1 && data.generatedPrompt.size() <= 12000
        && data.createdAt is timestamp;
    }

    function isValidAdminRecord(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'grantedBy', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'grantedBy', 'createdAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.grantedBy is string && data.grantedBy.size() >= 1 && data.grantedBy.size() <= 128
        && data.createdAt is timestamp;
    }

    // --- COLLECTION RULES ---

    // Connection check doc
    match /test/connection {
      allow get: if true;
      allow list, create, update, delete: if false;
    }

    // Courses & nested Lessons
    match /courses/{courseId} {
      allow get: if isValidId(courseId);
      allow list: if true;
      allow create: if isAdmin()
        && isValidId(courseId)
        && isValidCourse(incoming())
        && incoming().id == courseId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(courseId)
        && isValidCourse(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(courseId);

      match /lessons/{lessonId} {
        allow get: if isValidId(courseId) && isValidId(lessonId);
        allow list: if isValidId(courseId);
        allow create: if isAdmin()
          && isValidId(courseId)
          && isValidId(lessonId)
          && isValidLesson(incoming(), courseId)
          && incoming().id == lessonId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/courses/$(courseId));
        allow update: if isAdmin()
          && isValidId(courseId)
          && isValidId(lessonId)
          && isValidLesson(incoming(), courseId)
          && incoming().id == existing().id
          && incoming().courseId == existing().courseId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/courses/$(courseId));
        allow delete: if isAdmin() && isValidId(courseId) && isValidId(lessonId);
      }
    }

    // Course Levels
    match /course_levels/{levelId} {
      allow get: if isValidId(levelId);
      allow list: if true;
      allow create, update: if isAdmin()
        && isValidId(levelId)
        && isValidCourseLevel(incoming())
        && incoming().id == levelId
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(levelId);
    }

    // Student Profiles (PII Isolated)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && isValidId(userId)
        && isValidStudentProfile(incoming(), userId)
        && (isOwner(userId) || isAdmin())
        && (incoming().role == 'student' || isAdmin())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidStudentProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            isOwner(userId)
            && incoming().role == existing().role
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'firstName', 'lastName', 'phone', 'country', 'countyOrState',
              'townOrCity', 'avatarUrl', 'selectedCourseId', 'selectedLevel', 'updatedAt'
            ])
          )
        );
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Enrollments
    match /enrollments/{enrollmentId} {
      allow get: if isValidCompositeId(enrollmentId)
        && isSignedIn()
        && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && isValidCompositeId(enrollmentId)
        && isValidEnrollment(incoming())
        && (incoming().userId == request.auth.uid || isAdmin())
        && incoming().id == enrollmentId
        && incoming().enrolledAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/courses/$(incoming().courseId));
      allow update: if isSignedIn()
        && isValidCompositeId(enrollmentId)
        && isValidEnrollment(incoming())
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().courseId == existing().courseId
        && incoming().enrolledAt == existing().enrolledAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            existing().userId == request.auth.uid
            && existing().status != 'completed'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'completedLessonIds', 'progressPercent', 'status', 'updatedAt', 'completedAt', 'level'
            ])
          )
        );
      allow delete: if isAdmin() && isValidCompositeId(enrollmentId);
    }

    // Certificates
    match /certificates/{certificateId} {
      allow get: if isValidCompositeId(certificateId)
        && isSignedIn()
        && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && isValidCompositeId(certificateId)
        && isValidCertificate(incoming())
        && incoming().id == certificateId
        && incoming().issuedAt == request.time
        && (
          isAdmin()
          || (
            incoming().userId == request.auth.uid
            && getAfter(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + incoming().courseId)).data.status == 'completed'
          )
        );
      allow update, delete: if isAdmin() && isValidCompositeId(certificateId);
    }

    // Saved AI Prompts
    match /saved_prompts/{promptId} {
      allow get: if isValidId(promptId)
        && isSignedIn()
        && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && isValidId(promptId)
        && isValidSavedPrompt(incoming())
        && incoming().id == promptId
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(promptId)
        && isSignedIn()
        && (existing().userId == request.auth.uid || isAdmin());
    }

    // Admins RBAC Registry
    match /admins/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin()
        && isValidId(userId)
        && isValidAdminRecord(incoming(), userId)
        && incoming().createdAt == request.time;
    }
  }
}
